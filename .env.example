# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin Emails (comma-separated allowlist for /admin/dashboard and /api/admin/*)
ADMIN_EMAILS=you@example.com,partner@example.com

# Email Notifications (new-message alerts via Resend — https://resend.com)
# Optional: when RESEND_API_KEY is unset, message emails are skipped (logged)
# and messaging keeps working without email delivery.
RESEND_API_KEY=re_...
RESEND_FROM=Hoe of All Hobbies <notifications@yourdomain.com>

# Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
